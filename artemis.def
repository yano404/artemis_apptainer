Bootstrap: docker
From: rootproject/root:{{ ROOT_TAG }}

%arguments
  # Defaults reproduce the pinned image. Override any of these at build time, e.g.
  #   apptainer build --fakeroot \
  #     --build-arg ROOT_TAG=6.36.00-ubuntu24.04 \
  #     --build-arg ROOT_VERSION=6.36.00 \
  #     --build-arg ARTEMIS_REF=<sha> --build-arg ARTEMIS_DATE=<yyyy-mm-dd> \
  #     artemis.sif artemis.def
  ROOT_TAG=6.34.00-ubuntu24.04
  ROOT_VERSION=6.34.00
  YAML_CPP_VERSION=0.7.0
  ARTEMIS_REF=966a83f93869254a17263b1db64186d55b15f048
  ARTEMIS_DATE=2025-10-31

%labels
  Description "Artemis on ROOT {{ ROOT_VERSION }} / Ubuntu 24.04"
  ROOT_Version {{ ROOT_VERSION }}
  Artemis_Commit {{ ARTEMIS_REF }}
  Artemis_Date {{ ARTEMIS_DATE }}
  yaml_cpp_Version {{ YAML_CPP_VERSION }}

%environment
  # ROOTSYS and PATH come from the base image's Docker ENV, and ROOT's libraries
  # are on the loader path via /etc/ld.so.conf (/opt/root/lib), so ROOT and
  # artemis run without any extra setup here. We deliberately do NOT source
  # $ROOTSYS/bin/thisroot.sh: Apptainer parses %environment with a Go-based shell
  # that chokes on the zsh-only syntax in thisroot.sh (e.g. `${(%):-%N}`),
  # printing a parse error on every exec/shell/run.

  export ARTEMIS_HOME=/opt/artemis
  export PATH=$ARTEMIS_HOME/bin:$PATH
  export LD_LIBRARY_PATH=/usr/local/lib:$ARTEMIS_HOME/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}

  if [ -f "$ARTEMIS_HOME/bin/thisartemis.sh" ]; then
    . "$ARTEMIS_HOME/bin/thisartemis.sh"
  fi

  # Prevent X11 shared memory errors in VNC / remote display environments
  export QT_X11_NO_MITSHM=1

%post
  set -eux
  export DEBIAN_FRONTEND=noninteractive

  apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates pkg-config \
    cmake ninja-build build-essential \
    libssl-dev zlib1g-dev libxml2-dev
  rm -rf /var/lib/apt/lists/*

  BUILDROOT=/opt/build
  mkdir -p "$BUILDROOT"

  # ---- yaml-cpp (shared library) ----
  git clone --branch yaml-cpp-{{ YAML_CPP_VERSION }} --depth 1 \
    https://github.com/jbeder/yaml-cpp.git "$BUILDROOT/yaml-cpp"

  cmake -S "$BUILDROOT/yaml-cpp" -B "$BUILDROOT/yaml-cpp-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr/local \
    -DYAML_BUILD_SHARED_LIBS=ON \
    -DBUILD_TESTING=OFF
  cmake --build "$BUILDROOT/yaml-cpp-build" -j"$(nproc)"
  cmake --install "$BUILDROOT/yaml-cpp-build"
  ldconfig

  # Locate the dir actually containing the shared library (lib vs lib64)
  YAML_LIBDIR=/usr/local/lib
  for D in /usr/local/lib /usr/local/lib64; do
    [ -e "$D/libyaml-cpp.so" ] && YAML_LIBDIR="$D" && break
  done
  echo "yaml-cpp libdir: $YAML_LIBDIR"

  # ---- Artemis (pinned commit) ----
  # Pin is set via the ARTEMIS_REF build-arg (default in %arguments). To bump,
  # pass --build-arg ARTEMIS_REF=<sha> --build-arg ARTEMIS_DATE=<date> (or edit
  # the defaults); the published image tag root<ROOT>-artemis<date>-<short-sha>
  # mirrors this pin.
  ARTEMIS_REF={{ ARTEMIS_REF }}
  mkdir -p "$BUILDROOT/artemis"
  git -C "$BUILDROOT/artemis" init -q
  git -C "$BUILDROOT/artemis" remote add origin https://github.com/artemis-dev/artemis.git
  git -C "$BUILDROOT/artemis" fetch --depth 1 origin "$ARTEMIS_REF"
  git -C "$BUILDROOT/artemis" checkout -q FETCH_HEAD

  # --no-as-needed: with the default --as-needed, ld drops the DT_NEEDED entry
  # for yaml-cpp from libraries that reference it only transitively. This breaks
  # linking the artemis executable (libcatloop.so uses yaml-cpp, but the exe does
  # not reference it directly) and, at runtime, plugin loading. Forcing the
  # explicit -lyaml-cpp with --no-as-needed resolves both. yaml-cpp itself is
  # found via its /usr/local install (a default CMake prefix), so no
  # -Dyaml-cpp_DIR / -DCMAKE_PREFIX_PATH hint is needed.
  cmake -S "$BUILDROOT/artemis" -B "$BUILDROOT/artemis-build" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/opt/artemis \
    -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--no-as-needed -L$YAML_LIBDIR -lyaml-cpp -Wl,-rpath,$YAML_LIBDIR" \
    -DCMAKE_MODULE_LINKER_FLAGS="-Wl,--no-as-needed -L$YAML_LIBDIR -lyaml-cpp -Wl,-rpath,$YAML_LIBDIR" \
    -DCMAKE_EXE_LINKER_FLAGS="-Wl,--no-as-needed -L$YAML_LIBDIR -lyaml-cpp -Wl,-rpath,$YAML_LIBDIR"
  cmake --build "$BUILDROOT/artemis-build" -j"$(nproc)"
  cmake --install "$BUILDROOT/artemis-build"

  rm -rf "$BUILDROOT"

%test
  test -x /opt/artemis/bin/artemis
  echo "artemis binary found: OK"

%runscript
  exec /bin/bash -l "$@"

%help
  Artemis (commit {{ ARTEMIS_REF }}, {{ ARTEMIS_DATE }}) + ROOT {{ ROOT_VERSION }} on Ubuntu 24.04
  Run `apptainer inspect artemis.sif` to see the exact pinned versions.

  Build (defaults reproduce the pinned image):
    apptainer build --fakeroot artemis.sif artemis.def

  Build a different ROOT / Artemis without editing this file:
    apptainer build --fakeroot \
      --build-arg ROOT_TAG=6.36.00-ubuntu24.04 \
      --build-arg ROOT_VERSION=6.36.00 \
      --build-arg ARTEMIS_REF=<sha> --build-arg ARTEMIS_DATE=<yyyy-mm-dd> \
      artemis.sif artemis.def

  Interactive shell:
    apptainer shell artemis.sif

  Run artemis directly:
    apptainer exec artemis.sif artemis

  With X11 forwarding (SSH -X or VNC):
    apptainer shell --bind /tmp/.X11-unix artemis.sif
